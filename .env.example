# Copy to .env and edit.

SECRET_KEY=dev-secret-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

DATABASE_URL=sqlite:///./data/shopassistant.db
BACKEND_URL=http://localhost:8000

OPENAI_API_KEY=sk-...
# School/corporate Wi-Fi: local only, never in production.
# SSL_VERIFY=false
KEEPER_MODEL=openai:gpt-4o-mini
KEEPER_TEMPERATURE=0.3
CHECKPOINT_DB_PATH=./data/checkpoints.db
ARCHIVIST_MODEL=openai:gpt-4o-mini

WORLDBOOK_DIR=./assets/policies
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=policies
EMBEDDING_MODEL=openai:text-embedding-3-small
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=4
RETRIEVAL_MODE=basic
